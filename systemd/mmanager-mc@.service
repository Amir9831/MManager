[Unit]
Description=MManager Minecraft server %i
After=network-online.target
Wants=network-online.target
[Service]
Type=simple
User=mmanager
Group=mmanager
WorkingDirectory=/var/lib/mmanager/servers/%i
ExecStart=/bin/bash -c 'if [ -x /var/lib/mmanager/servers/%i/run.sh ]; then exec /var/lib/mmanager/servers/%i/run.sh; else exec /usr/bin/java -Xms256M -Xmx1G -jar /var/lib/mmanager/servers/%i/server.jar nogui; fi'
Restart=on-failure
RestartSec=10
KillSignal=SIGINT
TimeoutStopSec=90
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/mmanager/servers/%i
LimitNOFILE=100000
[Install]
WantedBy=multi-user.target
