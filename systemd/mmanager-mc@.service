[Unit]
Description=MManager Minecraft server %i
Wants=mmanager-core.service
After=mmanager-core.service network-online.target
Wants=network-online.target
[Service]
Type=simple
User=mmanager
Group=mmanager
WorkingDirectory=/var/lib/mmanager/servers/%i
ExecStartPre=/opt/mmanager/current/venv/bin/python -m mmanager.runtime_prepare %i
ExecStart=/bin/bash -c 'if [ -x /var/lib/mmanager/servers/%i/run.sh ]; then exec /var/lib/mmanager/servers/%i/run.sh; else exec /usr/bin/java -Xms256M -Xmx1G -jar /var/lib/mmanager/servers/%i/server.jar nogui; fi'
Restart=on-failure
RestartSec=10
KillSignal=SIGINT
TimeoutStopSec=90
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
LogsDirectory=mmanager/servers
LogsDirectoryMode=0750
StandardOutput=append:/var/log/mmanager/servers/%i.log
StandardError=inherit
ReadWritePaths=/var/lib/mmanager/servers/%i /var/log/mmanager/servers
LimitNOFILE=100000
[Install]
WantedBy=multi-user.target
