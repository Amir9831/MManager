[Unit]
Description=MManager Core API
After=network.target
[Service]
Type=simple
User=mmanager
Group=mmanager
WorkingDirectory=/opt/mmanager/current
Environment=MMANAGER_DATA=/var/lib/mmanager
Environment=MMANAGER_CONFIG=/etc/mmanager
ExecStart=/opt/mmanager/current/venv/bin/uvicorn mmanager.api:app --host 127.0.0.1 --port 8765
ExecStartPost=/opt/mmanager/current/venv/bin/python -m mmanager.networking
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/mmanager /var/log/mmanager /etc/mmanager
[Install]
WantedBy=multi-user.target
