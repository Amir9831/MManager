[Unit]
Description=MManager Public Web Panel and API
After=network.target mmanager-core.service
Wants=network.target
[Service]
Type=simple
User=mmanager
Group=mmanager
SupplementaryGroups=systemd-journal
WorkingDirectory=/opt/mmanager/current
Environment=MMANAGER_DATA=/var/lib/mmanager
Environment=MMANAGER_CONFIG=/etc/mmanager
Environment=UVICORN_PORT=8766
EnvironmentFile=-/etc/mmanager/web.env
ExecStart=/opt/mmanager/current/venv/bin/uvicorn mmanager.api:public_app --host 0.0.0.0 --port ${UVICORN_PORT}
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/mmanager /var/log/mmanager /etc/mmanager
[Install]
WantedBy=multi-user.target
